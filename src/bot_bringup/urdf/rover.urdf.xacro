<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="omni_rover">

  <!-- ========================= -->
  <!-- Materials                 -->
  <!-- ========================= -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- ========================= -->
  <!-- Base                      -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>

      <geometry>
        <box size="0.60 0.45 0.20"/>
      </geometry>

      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>

      <geometry>
        <box size="0.60 0.45 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>

      <mass value="10.0"/>

      <inertia
        ixx="0.5"
        ixy="0.0"
        ixz="0.0"
        iyy="0.5"
        iyz="0.0"
        izz="0.5"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Front Left Wheel          -->
  <!-- ========================= -->

  <link name="wheel_front_left">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>

      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
    </collision>

  </link>

  <joint name="wheel_front_left_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="wheel_front_left"/>

    <origin xyz="0.20 0.18 0.075"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- Front Right Wheel         -->
  <!-- ========================= -->

  <link name="wheel_front_right">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>

      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
    </collision>

  </link>

  <joint name="wheel_front_right_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="wheel_front_right"/>

    <origin xyz="0.20 -0.18 0.075"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- Rear Wheel                -->
  <!-- ========================= -->

  <link name="wheel_rear">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>

      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
    </collision>

  </link>

  <joint name="wheel_rear_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="wheel_rear"/>

    <origin xyz="-0.20 0 0.075"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- LIDAR                    -->
  <!-- ========================= -->

  <link name="laser">

    <visual>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>

      <material name="red"/>

    </visual>

  </link>


  <joint name="laser_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="laser"/>

    <origin xyz="0 0 0.30"
            rpy="0 0 0"/>

  </joint>

</robot>
